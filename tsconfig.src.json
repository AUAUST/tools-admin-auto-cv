{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "env.d.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.src.tsbuildinfo",
    "target": "ESNext",
    "lib": [
      "es2022",
      "es2023.array",
      "es2023.intl",
      "es2024.collection",
      "es2024.object",
      "es2024.promise",
      "es2024.regexp",
      "es2024.string",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["vite/client"],
    "outDir": "./dist",
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
